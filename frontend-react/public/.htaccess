# React Router memakai routing sisi klien: semua path yang bukan berkas nyata
# harus dilayani index.html, kalau tidak /students dan sejenisnya akan 404
# ketika dibuka langsung atau di-refresh.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Jangan alihkan permintaan ke API atau folder backend
    RewriteRule ^backend(-api)?/ - [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.html [L]
</IfModule>

# index.html tidak boleh di-cache supaya pengguna selalu mendapat versi terbaru;
# aset ber-hash aman di-cache lama karena namanya berubah setiap build.
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(js|css|svg|woff2?|ttf|eot|png|jpg|jpeg|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Tutup akses ke berkas sensitif dan kode sumber yang tidak perlu dilayani
<FilesMatch "^\.env|composer\.(json|lock)$|package(-lock)?\.json$|\.md$">
    Require all denied
</FilesMatch>

Options -Indexes
